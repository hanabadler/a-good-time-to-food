// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model FamilyMember {
  id        Int      @id @default(autoincrement())
  name      String
  isChild   Boolean  @default(false)
  gender    String?  // "male" | "female" | "other" | null
  // Login / 2FA
  // clientCode: QR "מזהה לקוח" שמוצג במסך התחברות
  // totpSecret: secret (base32) ליצירת קודי TOTP באפליקציית Authenticator
  clientCode String? @unique
  totpSecret  String?
  totpEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  transactions Transaction[]
  transfersFrom ShareTransfer[] @relation("TransfersFrom")
  transfersTo   ShareTransfer[] @relation("TransfersTo")
  requestsFrom ShareRequest[] @relation("RequestsFrom")
  requestsTo   ShareRequest[] @relation("RequestsTo")
  deposits Deposit[]
  productRuleMemberships ProductRuleMember[]
  
  @@map("family_members")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  quantity    Int      @default(0)
  unit        String?
  // Allocation remainder rotation:
  // When originalQuantity % eligibleCount !== 0, extraOffset rotates who gets the +1
  extraOffset Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  rules       ProductRule[]
  transactions Transaction[]
  shareTransfers ShareTransfer[]
  shareRequests ShareRequest[]
  deposits Deposit[]
  
  @@map("products")
}

model ProductRule {
  id        Int      @id @default(autoincrement())
  productId Int
  ruleType  String   // "everyone" | "children_only" | "adults_only" | "specific_members"
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  members   ProductRuleMember[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("product_rules")
}

// Members explicitly included in a specific_members product rule.
// Backed by the `product_rule_members` table (created at runtime if missing).
model ProductRuleMember {
  productRuleId Int
  memberId      Int
  createdAt     DateTime @default(now())

  rule   ProductRule  @relation(fields: [productRuleId], references: [id], onDelete: Cascade)
  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([productRuleId, memberId])
  @@map("product_rule_members")
}

model Transaction {
  id        Int      @id @default(autoincrement())
  productId Int
  memberId  Int
  quantity  Int
  notes     String?
  createdAt DateTime @default(now())
  
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  @@map("transactions")
}

model ShareTransfer {
  id        Int      @id @default(autoincrement())
  productId Int
  fromMemberId Int
  toMemberId   Int
  quantity  Int
  createdAt DateTime @default(now())
  
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromMember FamilyMember @relation("TransfersFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember   FamilyMember @relation("TransfersTo", fields: [toMemberId], references: [id], onDelete: Cascade)
  
  @@map("share_transfers")
}

model ShareRequest {
  id        Int      @id @default(autoincrement())
  productId Int
  fromMemberId Int  // מי מבקש
  toMemberId   Int  // ממי מבקשים
  quantity  Int
  status    String  @default("pending") // "pending" | "approved" | "rejected" | "cancelled"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromMember FamilyMember @relation("RequestsFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember   FamilyMember @relation("RequestsTo", fields: [toMemberId], references: [id], onDelete: Cascade)
  
  @@map("share_requests")
}

model Deposit {
  id        Int      @id @default(autoincrement())
  memberId  Int
  productId Int
  amount    Float    // סכום הכסף בפיקדון
  paymentMethod String @default("card") // "card" | "cash"
  cardNumber String? // מס' כרטיס אשראי (רק לרישום, לא אמיתי)
  cvv       String? // CVV
  expiryDate String? // תוקף
  idNumber  String? // תעודת זהות
  createdAt DateTime @default(now())
  
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@map("deposits")
}
